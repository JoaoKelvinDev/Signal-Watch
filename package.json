{
  "name": "radar-ia-tecnologia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project database",
    "test:online": "node --env-file-if-exists=.env --import tsx scripts/checks/contracts.ts",
    "test:http": "node --import tsx scripts/checks/feed-http.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/database/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/database/seed.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/backend/worker/main.ts",
    "collect:once": "node --env-file-if-exists=.env --import tsx src/backend/worker/main.ts --once",
    "editorial:process": "node --env-file-if-exists=.env --import tsx scripts/editorial/process.ts",
    "local": "node --env-file-if-exists=.env scripts/local.mjs",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
