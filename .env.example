# Obrigatório no servidor; nunca usar NEXT_PUBLIC_.
DATABASE_URL=postgresql://radar:SUBSTITUA_A_SENHA@localhost:5432/radar
# Supabase/Vercel: usar URI do pooler em modo transaction (porta 6543), somente no servidor.
# Migrações: URI direta ou pooler em modo session (porta 5432); não necessária no runtime Vercel.
MIGRATION_DATABASE_URL=
# Opcional: certificado CA do painel Supabase se necessário. TLS sempre valida o servidor.
DATABASE_CA_CERT=
# Administração e cron: segredos diferentes, aleatórios, com pelo menos 32 caracteres. Sem valor padrão.
ADMIN_PASSWORD=
CRON_SECRET=
# Origem pública para CSRF. Na Vercel, usa VERCEL_PROJECT_PRODUCTION_URL automaticamente.
# APP_ORIGIN=https://signal-watch-ten.vercel.app
POSTGRES_USER=radar
POSTGRES_DB=radar
POSTGRES_PASSWORD=
# Opcional: token somente de leitura para repositórios públicos.
GITHUB_TOKEN=
# Opcional para npm run local: porta HTTP (padrão 3000), somente loopback.
# PORT=3000
# Opcional: pasta dos binários PostgreSQL para o cluster local existente.
# RADAR_POSTGRES_BIN=C:/Program Files/PostgreSQL/18w/bin
# Coleta funciona sem LLM e sem Reddit. Nenhuma dessas integrações está ativada.
