# Obrigatório no servidor; nunca usar NEXT_PUBLIC_.
DATABASE_URL=postgresql://radar:SUBSTITUA_A_SENHA@localhost:5432/radar
POSTGRES_USER=radar
POSTGRES_DB=radar
POSTGRES_PASSWORD=
# Opcional: token somente de leitura para repositórios públicos.
GITHUB_TOKEN=
# Opcional para npm run local: porta HTTP (padrão 3000), somente loopback.
# PORT=3000
# Opcional: pasta dos binários PostgreSQL para o cluster local existente.
# RADAR_POSTGRES_BIN=C:/Program Files/PostgreSQL/18w/bin
# Coleta funciona sem LLM e sem Reddit. Nenhuma dessas integrações está ativada.
